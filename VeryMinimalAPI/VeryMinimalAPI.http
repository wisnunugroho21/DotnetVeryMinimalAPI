@VeryMinimalAPI_HostAddress = http://localhost:5015

GET {{VeryMinimalAPI_HostAddress}}/todos/
Accept: application/json

###

GET {{VeryMinimalAPI_HostAddress}}/todos?skip=0&take=1&filters=[{"field":"name","logic": "and", "constraints": [{"operator":"starts-with", "keyword":"Go"}]}]
Accept: application/json

###

POST {{VeryMinimalAPI_HostAddress}}/todos/
Accept: application/json
Content-Type: application/json

{
    "todo": {
        "name": "Walk dog",
        "isComplete": true
    }
}

###

PUT {{VeryMinimalAPI_HostAddress}}/todos/
Accept: application/json
Content-Type: application/json

{
    "todo": {
      "name": "Walk dog",
      "isComplete": true,
      "id": 1
    }
}

###

GET {{VeryMinimalAPI_HostAddress}}/todos/1
Accept: application/json

###

DELETE {{VeryMinimalAPI_HostAddress}}/todos/1
Accept: application/json

###
