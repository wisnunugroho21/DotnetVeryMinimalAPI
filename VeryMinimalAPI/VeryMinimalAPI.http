@DotnetTutorial2_HostAddress = http://localhost:5015

GET {{DotnetTutorial2_HostAddress}}/todos/
Accept: application/json

###

POST {{DotnetTutorial2_HostAddress}}/todos/
Accept: application/json
Content-Type: application/json

{
    "todo": {
        "name": "Walk dog",
        "isComplete": true
    }
}

###

PUT {{DotnetTutorial2_HostAddress}}/todos/
Accept: application/json
Content-Type: application/json

{
    "todo": {
      "name": "Walk dog",
      "isComplete": true,
      "id": 1
    }
}

###

GET {{DotnetTutorial2_HostAddress}}/todos/1
Accept: application/json

###

DELETE {{DotnetTutorial2_HostAddress}}/todos/1
Accept: application/json

###
